{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "tbCalcDax",
  "position": {
    "x": 492,
    "y": 340,
    "z": 0,
    "width": 772,
    "height": 364,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1.  Sales = SUM ( CategoryMonthlySales[SalesAmount] )",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#1F4E79"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        No CALCULATE. Each row answers the filter the visual gave it.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2.  Sales Camping = CALCULATE ( [Sales], ...[Category] = \"Camping\" )",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#1F4E79"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        Category is already on rows, so this REPLACES that filter:",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        all four rows read $3,302,900.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3.  Sales Camping Kept = CALCULATE ( [Sales], KEEPFILTERS ( ...same... ) )",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#1F4E79"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        KEEPFILTERS intersects instead of replacing - only Camping survives.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4.  Sales All Categories = CALCULATE ( [Sales], REMOVEFILTERS ( ...[Category] ) )",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#1F4E79"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        Takes the filter away: every row shows the $6,637,231 total.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5.  Category Share % = DIVIDE ( [Sales], [Sales All Categories] )",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#1F4E79"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "        Numerator moves, denominator does not. The shares add to 100.0%.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bottom left: the same [Sales Camping] with Month on rows. Category is not on rows there, so there is no Category filter to replace and the filter simply applies - Camping's own monthly numbers, not $3,302,900.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "More variants, with their expected answers, are in scripts/calculate-filter-context.dax.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#333333"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
