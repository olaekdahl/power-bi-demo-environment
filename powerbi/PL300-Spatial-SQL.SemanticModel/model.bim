              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "NearestIsHomeStore",
            "dataType": "string",
            "sourceColumn": "NearestIsHomeStore",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "CustomerNearestStore-partition",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"PL300Demo\"),",
                "    dbo_vw_CustomerNearestStore = Source{[Schema=\"dbo\",Item=\"vw_CustomerNearestStore\"]}[Data]",
                "in",
                "    dbo_vw_CustomerNearestStore"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Customers Assessed",
            "expression": "COUNTROWS ( CustomerNearestStore )",
            "formatString": "#,0"
          },
          {
            "name": "Nearest Is Home Store",
            "expression": "CALCULATE ( COUNTROWS ( CustomerNearestStore ), CustomerNearestStore[NearestIsHomeStore] = \"Yes\" )",
            "formatString": "#,0"
          },
          {
            "name": "Reassignment Candidates",
            "expression": "COALESCE ( CALCULATE ( COUNTROWS ( CustomerNearestStore ), CustomerNearestStore[NearestIsHomeStore] = \"No\" ), 0 )",
            "formatString": "#,0"
          },
          {
            "name": "Assignment Match Rate",
            "expression": "DIVIDE ( [Nearest Is Home Store], [Customers Assessed] )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Avg Nearest Distance Km",
            "expression": "AVERAGE ( CustomerNearestStore[DistanceKm] )",
            "formatString": "#,0.00"
          }
        ]
      },
