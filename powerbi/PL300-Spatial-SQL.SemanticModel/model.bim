              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"PL300Demo\"),",
                "    dbo_vw_StoreRegionCheck = Source{[Schema=\"dbo\",Item=\"vw_StoreRegionCheck\"]}[Data]",
